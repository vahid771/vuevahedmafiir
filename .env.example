PORT=3001
JWT_SECRET=change_me_to_a_long_random_secret
OPENAI_API_KEY=sk-...
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token
UPLOADS_DIR=./uploads

# Google OAuth2 (required for Google Drive integration)
# Create credentials at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Add both redirect URIs to your OAuth2 client:
#   Local:      http://localhost:3001/api/google/callback
#   Production: https://<your-vercel-project>.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Google Tasks OAuth2 (same client ID/secret as Drive, but separate redirect URI)
# Add this redirect URI to your OAuth2 client in the Google Cloud Console:
#   Local:      http://localhost:3001/api/google-tasks/callback
#   Production: https://<your-vercel-project>.vercel.app/api/google-tasks/callback
GOOGLE_TASKS_REDIRECT_URI=http://localhost:3001/api/google-tasks/callback

# Where to redirect after OAuth completes (should be your client origin)
# Local:      http://localhost:5173
# Production: https://<your-vercel-project>.vercel.app
CLIENT_ORIGIN=http://localhost:5173
